{
  "name": "linklight",
  "private": true,
  "version": "1.0.0",
  "description": "Document your network closets as interactive 3D racks: glowing link lights, port hover cards, photos and a shared equipment library.",
  "contributors": [
    "Taylor Thimmesh",
    "Jackson Hurst",
    "Aaron Mills"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TThimmesh/Linklight.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "snapshot": "node scripts/snapshot-legacy.mjs",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@supabase/supabase-js": "^2.117.2",
    "firebase": "^12.19.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
